<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: a normal Windows app, so no console window opens behind it -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>DustysGanjaria</AssemblyName>
    <RootNamespace>DustysGanjaria</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The .exe icon (and so the shortcut's); made from art/icon by art/icon/make_ico.ps1 -->
    <ApplicationIcon>resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game font and its licence (the licence must ship with the font) -->
    <None Include="resources\fonts\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window and taskbar icon, loaded at start-up -->
    <None Include="resources\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Optional sounds: resources\sounds\doorbell.wav replaces the chime made in code (see Audio.cs) -->
    <None Include="resources\sounds\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sprite sheets cut by tools/gen-sprites.js and tools/Cutter (png plus its json); a missing one leaves the placeholder -->
    <None Include="resources\sprites\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools are their own projects (tools/Cutter); keep their code out of the game -->
    <Compile Remove="tools/**" />
  </ItemGroup>

  <!-- Raykit (sibling folder GitHub\raykit): window, fullscreen, screenshots, crash net, settings files.
       It brings Raylib-cs with it, so the Raylib version lives there. -->
  <ItemGroup>
    <ProjectReference Include="..\raykit\Raykit.csproj" />
  </ItemGroup>

</Project>
